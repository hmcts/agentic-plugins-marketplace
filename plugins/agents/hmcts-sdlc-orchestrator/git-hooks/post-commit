#!/usr/bin/env bash
# Git attribution shim of the hmcts-sdlc-orchestrator plugin. One body, installed as post-commit,
# post-rewrite and pre-push in ~/.cpp-harness/git-hooks (the global core.hooksPath after onboarding).
#
# 1. Runs the hook this one stands in for: "$(git config --global cpp.previousHooksPath)/<name>",
#    then the repository's own "<git common dir>/hooks/<name>", each only when executable and not
#    this shim. The stdin git gives post-rewrite and pre-push is read once and replayed to each.
# 2. Records a "git" event through `cpp_telemetry git-event` with a 1 s budget, run isolated
#    (python3 -I -B) from the data directory. With no forwarder running the event is dropped.
#    This part prints nothing and never fails or blocks the git command.
# Exit: post-commit and post-rewrite always 0. pre-push returns a chained hook's non-zero exit
# (that hook refused the push, so nothing is recorded), else 0.

set -u  # ${1+"$@"} below: bash 3.2 (macOS) treats an empty "$@" as unbound under set -u

name="${0##*/}"
case "$name" in
  post-commit) kind=commit ;;
  post-rewrite) kind=rewrite ;;
  pre-push) kind=push ;;
  *) exit 0 ;;
esac
case "$0" in
  */*) self_dir="${0%/*}" ;;
  *) self_dir=. ;;
esac

input=""
if [ "$kind" != commit ] && [ ! -t 0 ]; then
  IFS= read -r -d '' input || true
fi

prev_hook=""
prev_dir="$(git config --global --type=path --get cpp.previousHooksPath 2>/dev/null || true)"
[ -n "$prev_dir" ] && prev_hook="$prev_dir/$name"
repo_hook=""
common_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
[ -n "$common_dir" ] && repo_hook="$common_dir/hooks/$name"

# Runs one chained hook with the shim's arguments; returns that hook's exit code.
run_chained() {
  local hook="$1"
  shift
  if [ -z "$hook" ] || [ ! -f "$hook" ] || [ ! -x "$hook" ] || [ "$hook" -ef "$0" ]; then
    return 0
  fi
  if [ "$kind" = commit ]; then
    "$hook" ${1+"$@"}
  else
    "$hook" ${1+"$@"} < <(printf '%s' "$input")
  fi
}

code=0
run_chained "$prev_hook" ${1+"$@"} || code=$?
if [ "$kind" = push ] && [ "$code" -ne 0 ]; then
  exit "$code"
fi
if ! [ "$repo_hook" -ef "$prev_hook" ]; then
  run_chained "$repo_hook" ${1+"$@"} || code=$?
fi
if [ "$kind" = push ] && [ "$code" -ne 0 ]; then
  exit "$code"
fi

# Our part: a subshell, so its cd stays inside; never more than about 1 s.
record() (
  [ "${CPP_HARNESS_TELEMETRY:-on}" = "off" ] && exit 0
  data="${CLAUDE_PLUGIN_DATA:-${HOME:-}/.claude/plugins/data/hmcts-sdlc-orchestrator}"
  # No data dir, opted out, or no forwarder ever recorded a port: nothing can take the event.
  [ -d "$data" ] && [ ! -e "$data/opt-out" ] && [ -s "$data/port" ] || exit 0
  root=""
  [ -r "$self_dir/plugin-root" ] && IFS= read -r root <"$self_dir/plugin-root"
  [ -n "$root" ] || exit 0
  py=python3
  command -v "$py" >/dev/null 2>&1 || py=python
  command -v "$py" >/dev/null 2>&1 || exit 0
  CPP_TELEMETRY_GIT_CWD="$PWD"
  export CPP_TELEMETRY_GIT_CWD
  cd "$data" || exit 0
  if command -v timeout >/dev/null 2>&1; then
    timeout 1 "$py" -I -B "$root/bin/cpp_telemetry" git-event "$kind" ${1+"$@"} < <(printf '%s' "$input")
    exit 0
  fi
  "$py" -I -B "$root/bin/cpp_telemetry" git-event "$kind" ${1+"$@"} < <(printf '%s' "$input") &
  worker=$!
  (sleep 1 && kill "$worker") &
  watchdog=$!
  wait "$worker"
  kill "$watchdog"
  exit 0
)

record ${1+"$@"} </dev/null >/dev/null 2>&1
exit 0
